---
import Base from "../layouts/Base.astro";
import Badge from "../components/Badge.astro";
import RuledHeading from "../components/RuledHeading.astro";
import { cv } from "../data/cv";
---

<Base title={`${cv.name} — CV`} description={cv.summary}>
  <main>
    <header>
      <div class="masthead">
        <img src="/cv-flourish.svg" width="90" height="28" alt="" />
        <span>Curriculum vitae</span>
        <img class="mirrored" src="/cv-flourish.svg" width="90" height="28" alt="" />
      </div>
      <h1>{cv.name}</h1>
      <p class="about">{cv.about}</p>
      <p class="location"><a href={cv.locationLink}>{cv.location}</a></p>
      <ul class="contact">
        <li><a href={`mailto:${cv.email}`}>{cv.email}</a></li>
        {cv.social.map((s) => <li><a href={s.url}>{s.name}</a></li>)}
      </ul>
    </header>

    <section>
      <RuledHeading>About</RuledHeading>
      <p class="summary">{cv.summary}</p>
    </section>

    <section>
      <RuledHeading>Work Experience</RuledHeading>
      {
        cv.work.map((job) => (
          <article class="job">
            <div class="row">
              <h3>
                <a href={job.link}>{job.company}</a>
              </h3>
              <span class="dates">
                {job.start} – {job.end}
              </span>
            </div>
            <p class="role">{job.title}</p>
            <ul class="highlights">
              {job.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </article>
        ))
      }
    </section>

    <section>
      <RuledHeading>Education</RuledHeading>
      {
        cv.education.map((school) => (
          <article>
            <h3>{school.school}</h3>
            {school.degrees.map((d) => (
              <div class="degree">
                <div class="row">
                  <p class="role">{d.degree}</p>
                  <span class="dates">{d.end}</span>
                </div>
                <p class="detail">{d.detail}</p>
              </div>
            ))}
          </article>
        ))
      }
    </section>

    <section class="projects">
      <RuledHeading>Projects</RuledHeading>
      <div class="grid">
        {
          cv.projects.map((p) => (
            <article class="card">
              <h3>
                <a href={p.link.href}>{p.title}</a>
              </h3>
              <p class="print-only">{p.link.label}</p>
              <p class="detail">{p.description}</p>
              <div class="badges">
                {[p.kind, ...p.tech].map((t) => (
                  <Badge size="xs">{t}</Badge>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  :global(body) {
    /* Quickshell's Ochre secondary shade frames the lighter parchment. */
    background: #bfa476;
  }

  main {
    /* Quickshell's Ochre palette and RuledFrame: ink, lapis, then sap green. */
    --cv-rule: #bfa476;
    --cv-rust: #6b3a10;
    --cv-lapis: #2c4c9c;
    --cv-green: #3f6a2a;
    --cv-gilt: #c0903e;
    --cv-rubric: #b5361f;
    font-family: "Styrene B", Inter, system-ui, sans-serif;
    position: relative;
    isolation: isolate;
    width: calc(100% - 3rem);
    max-width: 56rem;
    margin: 2rem auto;
    padding: 2.5rem 3.5rem 3.5rem;
    background: var(--bg);
    border: 1px solid var(--fg);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    line-height: 1.65;
  }

  main::before,
  main::after {
    content: "";
    position: absolute;
    pointer-events: none;
    border: 1px solid;
  }

  main::before {
    inset: 4px;
    border-color: var(--cv-lapis);
    border-radius: 8px;
  }

  main::after {
    inset: 8px;
    border-color: var(--cv-green);
    border-radius: 4px;
  }

  a {
    color: var(--cv-rust);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: var(--link);
  }

  a:focus-visible {
    outline: 2px solid var(--cv-lapis);
    outline-offset: 4px;
    border-radius: 2px;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.035em;
    margin-top: 0.375rem;
  }

  h3 {
    min-width: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  h3 a {
    color: var(--fg);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  h3 a:hover {
    color: var(--cv-rust);
    text-decoration: underline;
  }

  header,
  section {
    display: flex;
    flex-direction: column;
  }

  header {
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--cv-rust);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .masthead img {
    flex: 0 0 auto;
  }

  .mirrored {
    transform: scaleX(-1);
  }

  section {
    gap: 1.5rem;
  }

  .about {
    max-width: 36rem;
    text-wrap: balance;
    color: var(--muted);
  }

  .summary {
    text-wrap: pretty;
  }

  .location,
  .contact,
  .dates,
  .print-only {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .location a {
    color: inherit;
    text-decoration: none;
  }

  .location a:hover {
    text-decoration: underline;
  }

  .contact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem 1.25rem;
  }

  .contact a {
    overflow-wrap: anywhere;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .role {
    color: var(--cv-rust);
    font-size: 1rem;
  }

  .dates {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .job + .job {
    padding-top: 1.5rem;
    border-top: 1px solid var(--cv-rule);
  }

  .highlights {
    margin-top: 0.75rem;
    padding-left: 1.15rem;
    font-size: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .highlights li::marker {
    color: var(--cv-rust);
    font-size: 0.8em;
  }

  .degree {
    margin-top: 0.75rem;
  }

  .detail {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    min-width: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    border: 1px solid var(--cv-rule);
    border-radius: 9px;
    background: var(--surface);
    padding: 1.125rem;
  }

  .card .detail {
    font-size: 1rem;
    color: var(--fg);
  }

  .card .badges {
    margin-top: auto;
    padding-top: 0.375rem;
  }

  .print-only {
    display: none;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    main {
      width: calc(100% - 1rem);
      margin: 0.5rem auto;
      padding: 1.5rem 1.375rem 2rem;
      gap: 2rem;
    }

    .masthead {
      gap: 0.5rem;
      letter-spacing: 0.07em;
    }

    .masthead img {
      width: 54px;
      height: auto;
    }

    .contact {
      gap: 0.375rem 1rem;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    :global(body) {
      background: white;
    }

    main {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      background: transparent;
      border: none;
      gap: 1.5rem;
      line-height: 1.45;
    }

    main::before,
    main::after {
      display: none;
    }

    .print-only {
      display: block;
      font-size: 0.75rem;
    }

    .job,
    .degree,
    .card,
    header {
      break-inside: avoid;
    }

    .highlights,
    .summary,
    .card .detail {
      font-size: 0.875rem;
    }

    .projects {
      break-before: page;
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .card {
      padding: 0.75rem;
      gap: 0.375rem;
    }

    .card {
      background: transparent;
    }
  }
</style>
