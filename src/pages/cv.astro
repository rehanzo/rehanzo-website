---
import Base from "../layouts/Base.astro";
import Badge from "../components/Badge.astro";
import { cv } from "../data/cv";
---

<Base title={`${cv.name} — CV`} description={cv.summary}>
  <main>
    <header>
      <h1>{cv.name}</h1>
      <p class="about">{cv.about}</p>
      <p class="location"><a href={cv.locationLink}>{cv.location}</a></p>
      <ul class="contact">
        <li><a href={`mailto:${cv.email}`}>{cv.email}</a></li>
        <li><a href={`tel:${cv.phone.replaceAll(" ", "")}`}>{cv.phone}</a></li>
        {cv.social.map((s) => <li><a href={s.url}>{s.name}</a></li>)}
      </ul>
    </header>

    <section>
      <h2>About</h2>
      <p class="summary">{cv.summary}</p>
    </section>

    <section>
      <h2>Work Experience</h2>
      {
        cv.work.map((job) => (
          <article>
            <div class="row">
              <h3>
                <a href={job.link}>{job.company}</a>
                {job.badges.map((b) => <Badge>{b}</Badge>)}
              </h3>
              <span class="dates">
                {job.start} – {job.end}
              </span>
            </div>
            <p class="role">{job.title}</p>
            <ul class="highlights">
              {job.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </article>
        ))
      }
    </section>

    <section>
      <h2>Education</h2>
      {
        cv.education.map((school) => (
          <article>
            <h3>{school.school}</h3>
            {school.degrees.map((d) => (
              <div class="degree">
                <div class="row">
                  <p class="role">{d.degree}</p>
                  <span class="dates">{d.end}</span>
                </div>
                <p class="detail">{d.detail}</p>
              </div>
            ))}
          </article>
        ))
      }
    </section>

    <section>
      <h2>Skills</h2>
      <div class="badges">
        {cv.skills.map((s) => <Badge variant="solid">{s}</Badge>)}
      </div>
    </section>

    <section class="projects">
      <h2>Projects</h2>
      <div class="grid">
        {
          cv.projects.map((p) => (
            <article class="card">
              <h3>
                <a href={p.link.href}>{p.title}</a>
              </h3>
              <p class="print-only">{p.link.label}</p>
              <p class="detail">{p.description}</p>
              <div class="badges">
                {[p.kind, ...p.tech].map((t) => (
                  <Badge size="xs">{t}</Badge>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  main {
    font-family: Inter, system-ui, sans-serif;
    max-width: 42rem;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Wider screens get more breathing room. */
  @media (min-width: 768px) {
    main {
      padding: 4rem 1rem;
    }
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: 1.5rem;
  }

  h2 {
    font-size: 1.25rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  header,
  section {
    display: flex;
    flex-direction: column;
  }

  header {
    gap: 0.375rem;
  }

  section {
    gap: 1rem;
  }

  .about,
  .summary,
  .location,
  .contact,
  .role,
  .dates,
  .detail,
  .print-only {
    font-family: var(--font-mono);
  }

  .about,
  .summary {
    font-size: 0.875rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .location,
  .detail {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .contact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* A row with something on the left and dates pushed to the right. */
  .row {
    display: flex;
    flex-wrap: wrap; /* on narrow screens, dates drop below instead of squashing */
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .role,
  .dates {
    font-size: 0.875rem;
  }

  .dates {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .highlights {
    margin-top: 0.5rem;
    padding-left: 1rem;
    font-size: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .degree {
    margin-top: 0.5rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  /* Projects: 1 column on phones, 2 on tablets, 3 on desktops.
     minmax(0, 1fr) lets columns shrink below their longest word, so long text
     can't push the grid wider than the page. */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border: 1px solid var(--surface);
    border-radius: 0.5rem;
    padding: 0.75rem;
  }

  /* Push the tags to the bottom so cards in a row line up. */
  .card .badges {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* The little green dot after each project title. */
  .card h3 a::after {
    content: "";
    display: inline-block;
    width: 0.25rem;
    height: 0.25rem;
    margin-left: 0.25rem;
    vertical-align: middle;
    border-radius: 50%;
    background: var(--accent);
  }

  .print-only {
    display: none;
    overflow-wrap: anywhere; /* long URLs may break anywhere rather than overflow */
  }

  /* Print / "Save as PDF" version. */
  @media print {
    main {
      padding: 0;
      gap: 1.5rem;
    }

    .print-only {
      display: block;
      font-size: 0.75rem;
      text-decoration: underline;
    }

    .projects {
      break-before: page;
    }

    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }
  }
</style>
