---
// A small pill-shaped label, used for skills, project tags and "Remote".
interface Props {
  variant?: "solid" | "soft";
  size?: "sm" | "xs";
}

const { variant = "soft", size = "sm" } = Astro.props;
---

<span class:list={["badge", variant, size]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: 0.375rem;
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-weight: 600;
    white-space: nowrap;
    /* Browsers skip background colours when printing by default; keep them. */
    print-color-adjust: exact;
  }

  .sm {
    font-size: 0.75rem;
  }

  .xs {
    font-size: 0.625rem;
    padding: 0 0.25rem;
  }

  .solid {
    background: var(--fg);
    color: var(--bg);
  }

  .soft {
    background: var(--surface);
    color: var(--fg);
  }
</style>
