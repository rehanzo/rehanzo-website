---
// A small pill-shaped label, used for skills, project tags and "Remote".
interface Props {
  variant?: "solid" | "soft";
  size?: "sm" | "xs";
}

const { variant = "soft", size = "sm" } = Astro.props;
---

<span class:list={["badge", variant, size]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--cv-rule, var(--muted));
    border-radius: 4px;
    padding: 0.125rem 0.5rem;
    font-family: inherit;
    font-weight: 400;
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: normal;
    /* Browsers skip background colours when printing by default; keep them. */
    print-color-adjust: exact;
  }

  .sm {
    font-size: 0.875rem;
  }

  .xs {
    font-size: 0.75rem;
    padding: 0 0.25rem;
  }

  .solid {
    background: var(--fg);
    color: var(--bg);
  }

  .soft {
    background: var(--surface);
    color: var(--fg);
  }
</style>
