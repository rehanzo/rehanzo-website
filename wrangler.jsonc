// Cloudflare Workers config: how `wrangler deploy` publishes the site.
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rehanzo-website",
  "compatibility_date": "2026-11-13",
  // Serve the site on rehanzo.com. Cloudflare creates the DNS record and the
  // HTTPS certificate for it on deploy.
  "routes": [{ "pattern": "rehanzo.com", "custom_domain": true }],
  "assets": {
    // Upload the static site Astro builds.
    "directory": "./dist",
    // Serve /blog/tech from blog/tech.html (and redirect /blog/tech.html to it).
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
